<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/login.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
    
    <title>ContaCerta</title>
</head>
<body>
<main>
    <h1>Nova Conta</h1>
    <form action="~/novaConta" method="post">
        <input type="text" placeholder="Insira seu nome" name="nome" id="nome">
        <input type="email" placeholder="Insira um e-mail" name="email" id="email">
        <input type="password" placeholder="Insira uma senha" name="senha" id="senha">
        <input type="password" placeholder="Insira uma senha" name="senhaConfirmacao" id="senhaConfirmacao">
        <button type="submit">Criar Conta</button>
    </form>
</main>
</body>
</html>