@model IEnumerable<MovimentacaoResponse>

@{
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-yEPZ7jP9S0QKiUQ0m3jjsO4ProIW7wvR9gXkI7JOGa2XVsw53Yke2bsdkBbjmmiX" crossorigin="anonymous">

<h1>ContaCerta - Movimentações</h1>

<div id="tabela" class="border rounded-3 overflow-auto" style="margin:20px">
    <table class="table table-hover table-striped mb-0">
        <thead>
        <tr>
            <th scope="col">Tipo</th>
            <th scope="col">Data da Movimentação</th>
            <th scope="col">Nome</th>
            <th scope="col">Descrição</th>
            <th scope="col">Valor</th>
        </tr>
        </thead>

        @foreach (MovimentacaoResponse movto in Model)
        {
            <tbody>
            <tr>
                <td>@movto.TipoMovto</td>
                <td>@movto.DataMovto.ToString("dd/MM/yyyy")</td>
                <td>@movto.Nome</td>
                <td>@movto.Descricao</td>
                @if(@movto.TipoMovto != "Entrada")
                {
                    <td>-@movto.Valor</td>
                }
                else
                {
                    <td>@movto.Valor</td>
                }
            </tr>
            </tbody>
        }
    </table>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-WyOxWvTyr1QaMPfiPJSv76iReVthorl5uWlFtZPyK0IEB0hGzo9y5Bp9mYanr8Bu"
        crossorigin="anonymous"></script>
